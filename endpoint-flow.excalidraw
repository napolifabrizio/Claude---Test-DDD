    {
      "id": "ep_ref_text",
      "type": "text",
      "x": 1380,
      "y": 60,
      "width": 500,
      "height": 680,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "seed": 71,
      "version": 2,
      "versionNonce": 1813832834,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772987789717,
      "link": null,
      "locked": false,
      "groupIds": [],
      "frameId": null,
      "text": "ALL ENDPOINTS\n────────────────────────\nCUSTOMERS\nPOST /customers\n  -> CreateCustomerUseCase\nGET  /customers/{id}\n  -> customer_repo.find_by_id\n────────────────────────\nPRODUCTS\nPOST /products\n  -> CreateProductUseCase\nGET  /products\n  -> product_repo.find_all\nGET  /products/{id}\n  -> product_repo.find_by_id\n────────────────────────\nORDERS\nPOST /orders\n  -> CreateOrderUseCase\nGET  /orders/{id}\n  -> order_repo.find_by_id\nPOST /orders/{id}/items  <- THIS FLOW\n  -> AddItemToOrderUseCase\nPOST /orders/{id}/place\n  -> PlaceOrderUseCase\nPOST /orders/{id}/cancel\n  -> CancelOrderUseCase",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ep_ref_rect",
      "originalText": "ALL ENDPOINTS\n────────────────────────\nCUSTOMERS\nPOST /customers\n  -> CreateCustomerUseCase\nGET  /customers/{id}\n  -> customer_repo.find_by_id\n────────────────────────\nPRODUCTS\nPOST /products\n  -> CreateProductUseCase\nGET  /products\n  -> product_repo.find_all\nGET  /products/{id}\n  -> product_repo.find_by_id\n────────────────────────\nORDERS\nPOST /orders\n  -> CreateOrderUseCase\nGET  /orders/{id}\n  -> order_repo.find_by_id\nPOST /orders/{id}/items  <- THIS FLOW\n  -> AddItemToOrderUseCase\nPOST /orders/{id}/place\n  -> PlaceOrderUseCase\nPOST /orders/{id}/cancel\n  -> CancelOrderUseCase",
      "lineHeight": 1.25,
      "index": "au",
      "roundness": null,
      "autoResize": true
    },
