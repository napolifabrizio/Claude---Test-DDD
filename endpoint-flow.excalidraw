      "groupIds": [],
      "frameId": null,
      "text": "COLOR LEGEND\n────────────────────────\nBlue bg    = HTTP Interface Layer\nIndigo bg  = Composition Root (DI)\nGreen bg   = Application Use Cases\nYellow bg  = Domain Layer\nRed bg     = Infrastructure / Repos\nOrange bg  = Adapters / ACL\nPurple bg  = Shared Kernel\n────────────────────────\n- - -  Dashed arrow = returns value\n  ->   Solid arrow  = calls / invokes",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "legend_rect",
      "originalText": "COLOR LEGEND\n────────────────────────\nBlue bg    = HTTP Interface Layer\nIndigo bg  = Composition Root (DI)\nGreen bg   = Application Use Cases\nYellow bg  = Domain Layer\nRed bg     = Infrastructure / Repos\nOrange bg  = Adapters / ACL\nPurple bg  = Shared Kernel\n────────────────────────\n- - -  Dashed arrow = returns value\n  ->   Solid arrow  = calls / invokes",
      "lineHeight": 1.25,
      "index": "aw",
